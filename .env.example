# Contactformulier — verzending via Resend.
# Zonder deze waarden toont het formulier een nette foutmelding met het
# e-mailadres erin; de site blijft dus werken, alleen komt er niets binnen.

# API-key uit het Resend-dashboard. Zet hem op Vercel als environment variable,
# niet in de repo.
RESEND_API_KEY=

# Afzender van de mail. Moet op een domein staan dat in Resend geverifieerd is,
# anders weigeren SPF en DMARC de bezorging. Het antwoordadres wordt automatisch
# het adres van de aanvrager, dus dit adres hoeft geen echte mailbox te zijn.
CONTACT_FROM_EMAIL="Budding Creative Media <website@buddingcreativemedia.nl>"

# Waar de aanvraag naartoe gaat. Leeg laten valt terug op site.email.
CONTACT_TO_EMAIL=
